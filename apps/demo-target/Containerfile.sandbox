FROM docker.io/library/node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build

WORKDIR /build

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/tsconfig.json packages/contracts/tsconfig.build.json packages/contracts/
COPY packages/contracts/src packages/contracts/src
COPY apps/orchestrator/package.json apps/orchestrator/tsconfig.json apps/orchestrator/tsconfig.build.json apps/orchestrator/
COPY apps/orchestrator/src/spec-runner.ts apps/orchestrator/src/spec-runner.ts
COPY apps/demo-target/package.json apps/demo-target/tsconfig.json apps/demo-target/tsconfig.build.json apps/demo-target/
COPY apps/demo-target/src apps/demo-target/src
COPY apps/demo-target/runtime-package.json ./runtime-manifest/package.json
COPY apps/demo-target/runtime-package-lock.json ./runtime-manifest/package-lock.json

RUN npm ci --ignore-scripts --no-audit --no-fund \
 && npm run build -w @trustgate/contracts \
 && npm exec -- tsc \
      --target ES2022 \
      --module NodeNext \
      --moduleResolution NodeNext \
      --strict \
      --noUncheckedIndexedAccess \
      --exactOptionalPropertyTypes \
      --verbatimModuleSyntax \
      --skipLibCheck \
      --types node \
      --declaration \
      --rootDir apps/orchestrator/src \
      --outDir apps/orchestrator/dist \
      apps/orchestrator/src/spec-runner.ts \
 && npm exec -- tsc -p apps/demo-target/tsconfig.build.json \
 && mkdir -p /runtime/apps/demo-target/dist \
             /runtime/apps/orchestrator/dist \
             /runtime/packages/contracts/dist \
 && cp apps/demo-target/dist/sandbox-main.js \
       apps/demo-target/dist/server.js \
       apps/demo-target/dist/store.js \
       /runtime/apps/demo-target/dist/ \
 && cp apps/orchestrator/dist/spec-runner.js \
       /runtime/apps/orchestrator/dist/spec-runner.js \
 && cp packages/contracts/dist/index.js \
       /runtime/packages/contracts/dist/index.js \
 && npm ci \
      --prefix /build/runtime-manifest \
      --ignore-scripts \
      --no-audit \
      --no-fund \
      --omit=dev \
 && mv /build/runtime-manifest/node_modules /runtime/node_modules \
 && rm -rf /runtime/node_modules/@trustgate/contracts \
             /runtime/node_modules/@trustgate/orchestrator \
 && mkdir -p /runtime/node_modules/@trustgate/contracts/dist \
             /runtime/node_modules/@trustgate/orchestrator/dist \
 && printf '%s\n' \
      '{"name":"@trustgate/contracts","type":"module","exports":"./dist/index.js"}' \
      > /runtime/node_modules/@trustgate/contracts/package.json \
 && cp /runtime/packages/contracts/dist/index.js \
       /runtime/node_modules/@trustgate/contracts/dist/index.js \
 && printf '%s\n' \
      '{"name":"@trustgate/orchestrator","type":"module","exports":{"./spec-runner":"./dist/spec-runner.js"}}' \
      > /runtime/node_modules/@trustgate/orchestrator/package.json \
 && cp /runtime/apps/orchestrator/dist/spec-runner.js \
       /runtime/node_modules/@trustgate/orchestrator/dist/spec-runner.js \
 && find /runtime/node_modules -depth -type d \
      \( -name .bin -o -name .cache -o -name .claude -o -name .github \
         -o -name .husky -o -name bench -o -name benchmark -o -name benchmarks \
         -o -name docs -o -name example -o -name examples \
         -o -name fixture -o -name fixtures -o -name integration \
         -o -name scripts -o -name spec -o -name src \
         -o -name test -o -name tests \) \
      -exec rm -rf {} + \
 && find /runtime/node_modules -type f \
      \( -name '*.d.ts' -o -name '*.d.cts' -o -name '*.d.mts' \
         -o -name '*.map' -o -name '*.md' -o -name '*.ts' \
         -o -name '*.test.*' -o -name '*.spec.*' -o -name 'bench.js' \
         -o -name 'benchmark.js' -o -name 'example.js' -o -name 'example.mjs' \
         -o -name 'test.js' -o -name 'eslint.config.js' -o -name 'tsconfig.json' \
         -o -name 'tap-snapshots.test.js' \) \
      -delete \
 && rm -f /runtime/node_modules/.package-lock.json \
 && printf '%s\n' '{"private":true,"type":"module"}' > /runtime/package.json

FROM docker.io/library/node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS runtime

LABEL org.opencontainers.image.title="TrustGate sandbox target" \
      org.opencontainers.image.description="Task 10 bounded JSON plan executor" \
      trustgate.task="10"

RUN mkdir -p /app \
 && chown 65532:65532 /app
WORKDIR /app

COPY --from=build --chown=65532:65532 /runtime/ ./

USER 65532:65532
CMD ["node", "apps/demo-target/dist/sandbox-main.js"]
