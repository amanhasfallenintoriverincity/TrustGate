{
  "name": "@trustgate/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/ocr-adapter.js",
  "types": "dist/ocr-adapter.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ocr-adapter.d.ts",
      "default": "./dist/ocr-adapter.js"
    },
    "./ocr-adapter": {
      "types": "./dist/ocr-adapter.d.ts",
      "default": "./dist/ocr-adapter.js"
    },
    "./diff-collector": {
      "types": "./dist/diff-collector.d.ts",
      "default": "./dist/diff-collector.js"
    },
    "./planner": {
      "types": "./dist/planner.d.ts",
      "default": "./dist/planner.js"
    },
    "./spec-runner": {
      "types": "./dist/spec-runner.d.ts",
      "default": "./dist/spec-runner.js"
    },
    "./sandbox-policy": {
      "types": "./dist/sandbox-policy.d.ts",
      "default": "./dist/sandbox-policy.js"
    },
    "./sandbox-runner": {
      "types": "./dist/sandbox-runner.d.ts",
      "default": "./dist/sandbox-runner.js"
    },
    "./verdict": {
      "types": "./dist/verdict.d.ts",
      "default": "./dist/verdict.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:deps": "npm run build -w @trustgate/contracts && npm run build -w @trustgate/llm-gateway",
    "prebuild": "npm run build:deps",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build:deps",
    "test": "tsx --test test/*.test.ts",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trustgate/contracts": "0.1.0",
    "@trustgate/llm-gateway": "0.1.0",
    "execa": "10.0.1"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "1.12.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
