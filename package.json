{
  "name": "trustgate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["apps/*", "packages/*", "llm-gateway"],
  "overrides": {
    "@ai-sdk/provider-utils": "4.0.33"
  },
  "scripts": {
    "test": "node --test bin/trustgate.test.mjs && npm run test --workspaces --if-present",
    "trustgate": "node bin/trustgate.mjs",
    "start": "node apps/orchestrator/dist/main.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm test && npm run typecheck && npm run build"
  }
}
